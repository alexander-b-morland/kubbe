# Copy to .env.local and fill in. Never commit real values.

# Postgres connection strings. On Vercel these come from the Neon integration;
# locally, run `npx vercel env pull .env.local`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Locally these live in .env.development.local, which `vercel env pull` does not overwrite.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
