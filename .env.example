# Copy to .env.local and fill in. Never commit real values.

# Postgres connection strings. On Vercel these come from the Neon integration;
# locally, run `npx vercel env pull .env.local`.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Auth. Generate the secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Locally these live in .env.development.local, which `vercel env pull` does not overwrite.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Dinner ideas from Claude. Create a key at https://console.anthropic.com and add it
# with `npx vercel env add ANTHROPIC_API_KEY`. Left empty, ideas come from the built-in cookbook.
ANTHROPIC_API_KEY=
